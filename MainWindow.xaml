<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        PreviewKeyDown="EscMenu_KeyPress"
        ResizeMode="CanResize"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Title="Hastrman - Dobrodružství z rybníka" Icon="/icon.png">
    <Viewbox Stretch="Fill" >
        <Grid Name="main">

            <Image Name="pozadi" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill" Source="/img/0/0/backdrop.png" Margin="0,0,0,0"/>
            <Rectangle Panel.ZIndex="999" Name="rect" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Stretch" Fill="Black" VerticalAlignment="Stretch"/>

            <Grid Name="title_menu" Visibility="Collapsed">
                <Rectangle HorizontalAlignment="Stretch" Height="1080" Fill="Black" OpacityMask="#7F000000" VerticalAlignment="Stretch" Width="1920"/>

                <Button Name="createbtn" Click="NewGame_Click" Margin="1156,55,251,764" Cursor="Hand">
                    <Grid>
                        <Image Source="/button.png" Margin="-26,-20,-41,-32"></Image>
                        <TextBlock TextWrapping="Wrap" Text="Nová hra" Height="193" Width="478" RenderTransformOrigin="0.509,0.111" TextAlignment="Center" FontSize="72" FontWeight="Bold" FontFamily="Juice ITC" Margin="20,61,6,-32"/>
                    </Grid>
                </Button>

                <Button Name="existbtn" Click="Launch_Click" Margin="1156,404,251,404" Cursor="Hand">
                    <Grid>
                        <Image Source="/button.png" Margin="-26,-30,-41,-32"></Image>
                        <TextBlock TextWrapping="Wrap" Text="Pokračovat" Height="193" Width="478" RenderTransformOrigin="0.509,0.111" TextAlignment="Center" FontSize="72" FontWeight="Bold" FontFamily="Juice ITC" Margin="20,61,6,-32"/>
                    </Grid>
                </Button>
                <Button Name="quitbtn" Click="Quit_Click" Margin="1156,764,251,55" Cursor="Hand">
                    <Grid>
                        <Image Source="/button.png" Margin="-26,-21,-41,-32"></Image>
                        <TextBlock TextWrapping="Wrap" Text="Vypnout hru" Height="193" Width="478" RenderTransformOrigin="0.509,0.111" TextAlignment="Center" FontSize="72" FontWeight="Bold" FontFamily="Juice ITC" Margin="20,61,6,-32"/>
                    </Grid>
                </Button>
                <Image Source="/img/logo.png" HorizontalAlignment="Left" Height="566" Margin="129,0,0,0" VerticalAlignment="Center" Width="1017"/>
            </Grid>

            <Grid Name="pause_menu" Visibility="Collapsed">
                <Rectangle HorizontalAlignment="Stretch" Fill="Black" OpacityMask="#7F000000" VerticalAlignment="Stretch"/>
                <Button Name="continuebtn" Click="Continue_Click" Margin="703,255,703,599" Cursor="Hand">
                    <Grid RenderTransformOrigin="0.542,0.568">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="89*"/>
                            <RowDefinition Height="22*"/>
                        </Grid.RowDefinitions>
                        <Image Source="/button.png" Margin="-25,-27,-49,-26" Grid.RowSpan="2"></Image>
                        <TextBlock HorizontalAlignment="Stretch" TextWrapping="Wrap" Text="Zpátky do hry" VerticalAlignment="Stretch" Height="211" Width="450" RenderTransformOrigin="0.509,0.111" TextAlignment="Center" FontSize="72" FontWeight="Bold" FontFamily="Juice ITC" Margin="24,64,0,0" Grid.RowSpan="2"/>
                    </Grid>
                </Button>
                <Button Name="quitbtn2" Click="Quit_Click" Margin="704,574,703,280" Cursor="Hand">
                    <Grid>
                        <Image Source="/button.png" Margin="-20,-25,-46,-32"></Image>
                        <TextBlock HorizontalAlignment="Stretch" TextWrapping="Wrap" Text="Vypnout hru" VerticalAlignment="Stretch" Height="193" Width="478" RenderTransformOrigin="0.509,0.111" TextAlignment="Center" FontSize="72" FontWeight="Bold" FontFamily="Juice ITC" Margin="26,61,0,0"/>
                    </Grid>
                </Button>
            </Grid>

            <Grid x:Name="game" Visibility="Visible" Margin="0,854,0,52" Panel.ZIndex="999">
                <Rectangle Name="dialoguebg" Visibility="Hidden" HorizontalAlignment="Stretch" Height="250" Fill="Black" OpacityMask="#7F000000" VerticalAlignment="Center" Width="1868" Grid.ColumnSpan="2" Margin="26,0,0,0"/>
                <TextBlock Name="dialoguebar" Visibility="Hidden" HorizontalAlignment="Stretch" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Foreground="#FFE8CA00" FontSize="72" Width="1868" Height="154" TextAlignment="Center" FontFamily="Juice ITC" Grid.ColumnSpan="2" Margin="26,0,0,0" />
                <TextBlock Name="dialoguehelp" Visibility="Hidden" TextWrapping="Wrap" Text="Stiskni ENTER pro pokračování." VerticalAlignment="Top" Foreground="White" FontSize="40" Width="1868" Height="56" TextAlignment="Center" FontFamily="Juice ITC" Margin="42,184,10,0" />
            </Grid>

            <Grid Name="trezor" Visibility="Collapsed" Panel.ZIndex="1000">
                <Button Content="" Click="Num_Click" Tag="1" Cursor="Hand" Background ="White" Opacity="0.5" Height="50" Width="50" Margin="500,255,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Button Content="" Click="Num_Click" Tag="2" Cursor="Hand" Background ="White" Opacity="0.5" Height="50" Width="50" Margin="560,255,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Button Content="" Click="Num_Click" Tag="3" Cursor="Hand" Background ="White" Opacity="0.5" Height="50" Width="50" Margin="620,255,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Button Content="" Click="Num_Click" Tag="4" Cursor="Hand" Background ="White" Opacity="0.5" Height="50" Width="50" Margin="500,315,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Button Content="" Click="Num_Click" Tag="5" Cursor="Hand" Background ="White" Opacity="0.5" Height="50" Width="50" Margin="560,315,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Button Content="" Click="Num_Click" Tag="6" Cursor="Hand" Background ="White" Opacity="0.5" Height="50" Width="50" Margin="620,315,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Button Content="" Click="Num_Click" Tag="7" Cursor="Hand" Background ="White" Opacity="0.5" Height="50" Width="50" Margin="500,375,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Button Content="" Click="Num_Click" Tag="8" Cursor="Hand" Background ="White" Opacity="0.5" Height="50" Width="50" Margin="560,375,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Button Content="" Click="Num_Click" Tag="9" Cursor="Hand" Background ="White" Opacity="0.5" Height="50" Width="50" Margin="620,375,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Button Content="" Click="Num_Click" Tag="0" Cursor="Hand" Background ="White" Opacity="0.5" Height="50" Width="50" Margin="560,435,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <Button Content="" Click="Unlock_Click" Margin="264,188,0,0" Height="100" Width="110" Cursor="Hand" Background ="White" Opacity="0.5"/>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
