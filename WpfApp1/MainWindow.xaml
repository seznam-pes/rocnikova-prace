<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        PreviewKeyDown="EscMenu_KeyPress"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowState="Maximized"
        Title="Hra">
    <Viewbox Stretch="Fill">
        <Grid Width="1920" Height="1080">
            <Image Name="pozadi" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill" Source="img/placeholder.png" Margin="0,0,0,0"/>

            <Grid Name="title_menu" Visibility="Visible">
                <Rectangle HorizontalAlignment="Stretch" Height="1080" Fill="Black" OpacityMask="#7F000000" VerticalAlignment="Stretch" Width="1920"/>
                <Button Name="launchbtn" Click="Launch_Click" Margin="251,592,1156,262" Cursor="Hand">
                    <Grid RenderTransformOrigin="0.542,0.568">
                        <Image Source="/button.png" Margin="-26,-21,-41,-32"></Image>
                        <TextBlock HorizontalAlignment="Stretch" TextWrapping="Wrap" Text="Spustit hru" VerticalAlignment="Stretch" Height="211" Width="450" RenderTransformOrigin="0.509,0.111" TextAlignment="Center" FontSize="72" FontWeight="Bold" FontFamily="Juice ITC" Margin="24,64,0,0"/>
                    </Grid>
                </Button>
                <Button Name="quitbtn" Click="Quit_Click" Margin="1156,592,251,262" Cursor="Hand">
                    <Grid>
                        <Image Source="/button.png" Margin="-26,-21,-41,-32"></Image>
                        <TextBlock HorizontalAlignment="Stretch" TextWrapping="Wrap" Text="Vypnout hru" VerticalAlignment="Stretch" Height="193" Width="478" RenderTransformOrigin="0.509,0.111" TextAlignment="Center" FontSize="72" FontWeight="Bold" FontFamily="Juice ITC" Margin="26,61,0,0"/>
                    </Grid>
                </Button>
            </Grid>

            <Grid Name="pause_menu" Visibility="Collapsed">
                <Rectangle HorizontalAlignment="Stretch" Height="1080" Fill="Black" OpacityMask="#7F000000" VerticalAlignment="Stretch" Width="1920"/>
                <Button Name="continuebtn" Click="Continue_Click" Margin="703,255,703,599" Cursor="Hand">
                    <Grid RenderTransformOrigin="0.542,0.568">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="89*"/>
                            <RowDefinition Height="22*"/>
                        </Grid.RowDefinitions>
                        <Image Source="/button.png" Margin="-25,-26,-49,-26" Grid.RowSpan="2"></Image>
                        <TextBlock HorizontalAlignment="Stretch" TextWrapping="Wrap" Text="Zpátky do hry" VerticalAlignment="Stretch" Height="211" Width="450" RenderTransformOrigin="0.509,0.111" TextAlignment="Center" FontSize="72" FontWeight="Bold" FontFamily="Juice ITC" Margin="24,64,0,0" Grid.RowSpan="2"/>
                    </Grid>
                </Button>
                <Button Name="quitbtn2" Click="Quit_Click" Margin="704,574,703,280" Cursor="Hand">
                    <Grid>
                        <Image Source="/button.png" Margin="-20,-21,-46,-32"></Image>
                        <TextBlock HorizontalAlignment="Stretch" TextWrapping="Wrap" Text="Vypnout hru" VerticalAlignment="Stretch" Height="193" Width="478" RenderTransformOrigin="0.509,0.111" TextAlignment="Center" FontSize="72" FontWeight="Bold" FontFamily="Juice ITC" Margin="26,61,0,0"/>
                    </Grid>
                </Button>
            </Grid>

            <Grid Name="game" Visibility="Collapsed" Margin="0,854,0,52">
                <Rectangle HorizontalAlignment="Stretch" Height="250" Fill="Black" OpacityMask="#7F000000" VerticalAlignment="Center" Width="1868" Grid.ColumnSpan="2" Margin="26,0,0,0"/>
                <Rectangle HorizontalAlignment="Left" Height="182" Fill="Black" OpacityMask="#7F000000" VerticalAlignment="Top" Width="845" Margin="0,-854,0,0"/>
                <TextBlock HorizontalAlignment="Stretch" TextWrapping="Wrap" Text="TextčččBlock" VerticalAlignment="Center" Foreground="#FFE8CA00" FontSize="72" Width="1868" Height="154" TextAlignment="Center" FontFamily="Juice ITC" Grid.ColumnSpan="2" Margin="26,0,0,0" />
                <Grid>
                    <Rectangle HorizontalAlignment="Left" Height="160" Stroke="White" VerticalAlignment="Top" Width="160" StrokeThickness="10" Margin="10,-843,0,0"/>
                    <Rectangle HorizontalAlignment="Left" Height="160" Stroke="White" VerticalAlignment="Top" Width="160" StrokeThickness="10" Margin="175,-843,0,0"/>
                    <Rectangle HorizontalAlignment="Left" Height="160" Stroke="White" VerticalAlignment="Top" Width="160" StrokeThickness="10" Margin="340,-843,0,0"/>
                    <Rectangle HorizontalAlignment="Left" Height="160" Stroke="White" VerticalAlignment="Top" Width="160" StrokeThickness="10" Margin="505,-843,0,0"/>
                    <Rectangle HorizontalAlignment="Left" Height="160" Stroke="White" VerticalAlignment="Top" Width="160" StrokeThickness="10" Margin="670,-843,0,0"/>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
